{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://flowcrm-api.onrender.com/api/:path*" },
    { "source": "/uploads/:path*", "destination": "https://flowcrm-api.onrender.com/uploads/:path*" },
    { "source": "/login", "destination": "/app" },
    { "source": "/reset-password", "destination": "/app" },
    { "source": "/form/:path*", "destination": "/app" },
    { "source": "/(.*)", "destination": "/app" }
  ]
}
